(() => {
  const contentArea = document.getElementById('content-area');
  const weekNavigation = document.getElementById('week-navigation');
  const sidebar = document.getElementById('sidebar');
  const menuToggle = document.getElementById('menu-toggle');
  const sidebarOverlay = document.getElementById('sidebar-overlay');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const DATA_URL = 'data/weeks.yaml';

  let weekElements = [];
  let sectionObserver = null;

  const yaml = window.jsyaml;
  if (!yaml) {
    console.error('js-yaml library failed to load.');
    if (contentArea) {
      contentArea.innerHTML = '<div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded">Configuration error: js-yaml dependency is missing.</div>';
    }
    return;
  }

  const openSidebar = () => {
    sidebar.classList.remove('-translate-x-full');
    sidebarOverlay.classList.remove('hidden');
    requestAnimationFrame(() => sidebarOverlay.classList.remove('opacity-0'));
  };

  const closeSidebar = () => {
    sidebar.classList.add('-translate-x-full');
    sidebarOverlay.classList.add('opacity-0');
    setTimeout(() => sidebarOverlay.classList.add('hidden'), 250);
  };

  const bindNavigationHandlers = () => {
    if (menuToggle) {
      menuToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        if (sidebar.classList.contains('-translate-x-full')) {
          openSidebar();
        } else {
          closeSidebar();
        }
      });
    }

    if (sidebarOverlay) {
      sidebarOverlay.addEventListener('click', closeSidebar);
    }

    if (weekNavigation) {
      weekNavigation.addEventListener('click', (event) => {
        const link = event.target.closest('a');
        if (!link) return;
        event.preventDefault();
        const targetId = link.getAttribute('href');
        const target = targetId ? document.querySelector(targetId) : null;
        if (target) {
          const behavior = prefersReducedMotion.matches ? 'auto' : 'smooth';
          target.scrollIntoView({ behavior, block: 'start' });
          setActiveLink(targetId);
          if (history.replaceState) {
            history.replaceState(null, '', targetId);
          } else if (targetId) {
            window.location.hash = targetId;
          }
        }
        if (window.innerWidth < 768) {
          closeSidebar();
        }
      });
    }
  };

  const setActiveLink = (targetId) => {
    const links = weekNavigation.querySelectorAll('a.sidebar-link');
    links.forEach((anchor) => anchor.classList.remove('active'));
    if (!targetId) return;
    const link = weekNavigation.querySelector(`a[href="${targetId}"]`);
    if (link) link.classList.add('active');
  };

  const updateActiveLinkOnScroll = () => {
    const scrollPos = window.scrollY + 120;
    let activeId = null;
    for (const el of weekElements) {
      if (!el) continue;
      if (el.offsetTop <= scrollPos) {
        activeId = `#${el.id}`;
      }
    }
    setActiveLink(activeId);
  };

  const setupSectionObserver = () => {
    if (sectionObserver) {
      sectionObserver.disconnect();
      sectionObserver = null;
    }

    weekElements.forEach((el) => {
      if (el) {
        el.classList.add('week-transition');
        el.classList.remove('week-visible');
      }
    });

    if (prefersReducedMotion.matches || !('IntersectionObserver' in window)) {
      weekElements.forEach((el) => el && el.classList.add('week-visible'));
      return;
    }

    sectionObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('week-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '-10% 0px' });

    weekElements.forEach((el) => el && sectionObserver.observe(el));
  };

  const handleMotionPreferenceChange = () => {
    setupSectionObserver();
  };

  if (prefersReducedMotion.addEventListener) {
    prefersReducedMotion.addEventListener('change', handleMotionPreferenceChange);
  } else if (prefersReducedMotion.addListener) {
    prefersReducedMotion.addListener(handleMotionPreferenceChange);
  }

  const applyInlineMarkup = (value = '') => {
    if (!value) return '';
    let result = value.replace(/<\s*(https?:\/\/[^>\s]+)\s*>/g, '$1');
    result = result
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[(.*?)\]\((.*?)\)/g, '<a href=\"$2\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-blue-600 hover:underline\">$1</a>')
      .replace(/(?<!href=\")(?<!src=\")(https?:\/\/[^\s<]+)/g, '<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-blue-600 hover:underline\">$1</a>')
      .replace(/\*(?!\s)([^*]+?\S)\*/g, '<em>$1</em>');
    return result;
  };

  const formatText = (text = '') => {
    if (!text) return '';

    const normalized = text
      .replace(/\r/g, '')
      .replace(/\n\s{2,}(?![-*])/g, ' ')
      .replace(/\n{3,}/g, '\n\n');

    const lines = normalized.split('\n');
    let output = '';
    let inList = false;

    const closeList = () => {
      if (inList) {
        output += '</ul>';
        inList = false;
      }
    };

    for (const rawLine of lines) {
      const trimmed = rawLine.trim();
      if (/^[-*]\s+/.test(trimmed)) {
        if (!inList) {
          output += '<ul class=\"list-disc list-inside space-y-2\">';
          inList = true;
        }
        const itemText = applyInlineMarkup(trimmed.replace(/^[-*]\s+/, ''));
        output += `<li>${itemText}</li>`;
      } else if (trimmed.length === 0) {
        closeList();
        if (!output.endsWith('<div class=\"h-3\"></div>')) {
          output += '<div class=\"h-3\"></div>';
        }
      } else {
        closeList();
        output += `<p class=\"mb-2\">${applyInlineMarkup(trimmed)}</p>`;
      }
    }

    closeList();
    return output;
  };

  const formatBibliography = (bibText = '') => formatText(bibText);

  const renderProject = (week) => {
    if (!week || !week.project) return '';
    const project = week.project;

    const renderSubSection = (title, content) => {
      const body = formatText(content);
      if (!body) return '';
      return `<div class="space-y-2"><h5 class="text-sm font-semibold text-gray-600 uppercase tracking-wide">${title}</h5>${body}</div>`;
    };

    const objectiveSections = [
      renderSubSection('Overview', week.summary),
      renderSubSection('Notebook Deliverable', project.description),
      renderSubSection('Success Criteria', project.metrics)
    ].filter(Boolean).join('<div class="h-4"></div>');

    const descriptionSections = [
      renderSubSection('Dataset', project.dataset),
      renderSubSection('Objective Focus', project.objective),
      renderSubSection('Nuances', project.nuances),
      renderSubSection('Code Focus', week.code_focus),
      renderSubSection('Math & Stats', week.math_stats)
    ].filter(Boolean).join('<div class="h-4"></div>');

    const resourceSections = [
      renderSubSection('Dataset Links', project.dataset_links),
      renderSubSection('Documentation', week.docs),
      renderSubSection('Bibliography', week.bibliography)
    ].filter(Boolean).join('<div class="h-4"></div>');

    const cards = [];

    if (objectiveSections) {
      cards.push(`<section class="content-card bg-white p-5 lg:col-span-2"><h4>Objective</h4><div class="mt-4 space-y-4">${objectiveSections}</div></section>`);
    }
    if (descriptionSections) {
      cards.push(`<section class="content-card bg-white p-5 lg:col-span-2"><h4>Description</h4><div class="mt-4 space-y-4">${descriptionSections}</div></section>`);
    }
    if (resourceSections) {
      cards.push(`<section class="content-card bg-white p-5 lg:col-span-2"><h4>Resources</h4><div class="mt-4 space-y-4">${resourceSections}</div></section>`);
    }

    if (!cards.length) return '';

    return `
      <div class="project-section space-y-6">
        <h3 class="text-xl font-semibold text-gray-900">Project: ${project.title || ''}</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">${cards.join('')}</div>
      </div>
    `;
  };

  const renderWeek = (week) => `
    <section id="week-${week.number}" class="space-y-6">
      <header>
        <p class="text-sm uppercase tracking-wide text-gray-500">${week.phase || ''}</p>
        <h2 class="text-2xl font-bold text-gray-900 mt-1">Week ${week.number}: ${week.title}</h2>
      </header>
      ${renderProject(week)}
    </section>
  `;

  const buildNavigationAndContent = (weeks) => {
    const weekKeys = Object.keys(weeks).sort((a, b) => Number(a) - Number(b));
    weekNavigation.innerHTML = weekKeys.map((key) => {
      const wk = weeks[key];
      return `<a href="#week-${wk.number}" data-week="${wk.number}" class="sidebar-link">Week ${wk.number}: ${wk.title}</a>`;
    }).join('');

    contentArea.innerHTML = weekKeys.map((key) => renderWeek(weeks[key])).join('');
    weekElements = weekKeys.map((key) => document.getElementById(`week-${weeks[key].number}`));

    setupSectionObserver();
    updateActiveLinkOnScroll();
  };

  const showError = (message) => {
    contentArea.innerHTML = `<div class="bg-red-50 border border-red-200 text-red-800 p-4 rounded">${message}</div>`;
  };

  const loadWeeks = async () => {
    try {
      const response = await fetch(DATA_URL, { cache: 'no-cache' });
      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }
      const yamlText = await response.text();
      const weeks = yaml.load(yamlText);
      if (!weeks || typeof weeks !== 'object') {
        throw new Error('Roadmap data is empty or malformed');
      }
      buildNavigationAndContent(weeks);
      document.addEventListener('scroll', updateActiveLinkOnScroll, { passive: true });
      window.addEventListener('resize', updateActiveLinkOnScroll);
    } catch (error) {
      console.error('Failed to load roadmap data', error);
      const hint = window.location.protocol === 'file:'
        ? 'If you are opening this file directly from disk, please start a local web server so the browser can fetch data files (e.g. `python -m http.server`).'
        : 'Please try reloading the page or check the network tab for details.';
      showError(`Error loading roadmap data: ${error.message}. ${hint}`);
    }
  };

  bindNavigationHandlers();
  loadWeeks();
})();
